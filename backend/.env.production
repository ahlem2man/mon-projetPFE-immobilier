# PRODUCTION - Vercel Configuration
# IMPORTANT: Les variables doivent aussi être ajoutées dans Vercel Dashboard > Settings > Environment Variables

PORT=5000
NODE_ENV=production

# MongoDB - Remplacer par votre MongoDB Atlas URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/immobilier?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/immobilier?retryWrites=true&w=majority

# JWT Secret - Générer une clé sécurisée
JWT_SECRET=votre_clé_jwt_très_sécurisée_et_unique_pour_production

# Email Configuration
GMAIL_USER=votre_email@gmail.com
GMAIL_PASS=votre_mot_de_passe_application_gmail

# Frontend URL for CORS
FRONTEND_URL=https://mon-projet-pfe-immobilier-7son.vercel.app
