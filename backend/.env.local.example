# MongoDB Connection (utiliser une BD de test locale ou Atlas)
MONGO_URI=mongodb+srv://immobilier-app:motdepasse@cluster.mongodb.net/immobilier?retryWrites=true&w=majority

# Server Port
PORT=5000

# JWT Secret (peut être différent du prod)
